# Destination endpoint. The expected payload DTO and authentication must be verified.
OKSAPP_URL="https://oksapp.com.pg/api/coordinates"
DEVICE_ID="PI-GPS-001"

# If the API uses Bearer authentication, set a per-device token.
OKSAPP_TOKEN=""
# Optional alternative: API validates the X-API-Key request header.
OKSAPP_API_KEY=""

# Verify using: ls -l /dev/serial/by-id/ /dev/ttyUSB* /dev/ttyACM* 2>/dev/null
GPS_PORT="/dev/ttyUSB0"
# Common values are 9600 or 4800; use your actual G-Mouse baud rate.
GPS_BAUD="9600"
UPLOAD_INTERVAL="10"
